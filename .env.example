# ---- Database (PostgreSQL / Neon) ----
# The Prisma schema uses the postgresql provider. Use your Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth (required) ----
# Long random string. Sessions are signed with this; the app fails closed if it is unset.
JWT_SECRET=""
# Bootstrap admin. Used to seed the admin user and for first login before a DB user exists.
ADMIN_EMAIL="admin@opalchauffeurs.com.au"
ADMIN_PASSWORD=""

# ---- AI ----
ANTHROPIC_API_KEY=""
AI_MODEL_PRIMARY="claude-3-5-sonnet-20241022"
AI_MODEL_FAST="claude-3-5-haiku-20241022"

# ---- Enrichment ----
HUNTER_API_KEY=""

# ---- Company discovery: Google Places (new Places API v1) ----
# Enables live multi-source company discovery by location. Enable "Places API
# (New)" in Google Cloud and paste the key here.
GOOGLE_MAPS_API_KEY=""

# ---- Optional: inbound reply webhook shared secret ----
# If set, /api/replies/webhook requires header x-webhook-secret (or ?secret=) to match.
INBOUND_WEBHOOK_SECRET=""

# ---- Scheduled worker (auto follow-ups + reply sync) ----
# Required to enable /api/cron/run. Hit it on a schedule (e.g. cron-job.org) as
# /api/cron/run?secret=<CRON_SECRET>. Use a long random string.
CRON_SECRET=""

# ---- Optional: disable AI email generation (falls back to templates) ----
# AI_EMAIL_GENERATION="false"

# ---- Optional: Zoho IMAP for inbound reply sync ----
# IMAP_HOST="imappro.zoho.com"
# IMAP_PORT="993"
# IMAP_USER=""
# IMAP_PASS=""

# ---- Public app config ----
NEXT_PUBLIC_APP_NAME="Opal Outreach AI"
NEXT_PUBLIC_COMPANY_NAME="Opal Chauffeurs"
NEXT_PUBLIC_WEBSITE="https://www.opalchauffeurs.com.au/"
